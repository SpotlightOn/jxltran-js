# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Two trailing spaces are a hard line break in Markdown, so they have to survive.
[*.md]
trim_trailing_whitespace = false

# Patch context lines have to match the upstream files byte for byte.
[*.patch]
trim_trailing_whitespace = false
