@@ -0,0 +1,51 @@
+// Copyright (c) the JPEG XL Project Authors. All rights reserved.
+//
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Embedding interface of the jxltran pipeline.
+//
+// The whole command line tool, reduced to one function on memory buffers: the
+// caller passes a command line plus the INPUT file contents and gets the
+// OUTPUT file contents back. This is what the WebAssembly build of
+// jxltran-js links against - it has no main(). Files that flags refer to
+// (--set-exif FILE, --extract-*, --append-jxl, --set-splines-from) still go
+// through the regular file functions of the platform, so an embedder stages
+// them in the filesystem it provides (in WebAssembly: the virtual
+// filesystem).
+
+#ifndef TOOLS_JXLTRAN_API_H_
+#define TOOLS_JXLTRAN_API_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace jxltran {
+
+// Parses and validates the command line in |argv| and runs it: transforms
+// INPUT into OUTPUT and reports the result on stdout and stderr exactly like
+// the command line tool does. Returns 0 on success and 1 on failure; when it
+// fails, the diagnostic has already been written to stderr.
+//
+// |input_bytes| decides where INPUT and OUTPUT live:
+//
+//   nullptr  read the INPUT file and write the OUTPUT file named on the
+//            command line - what the command line tool does;
+//   buffer   take INPUT from the bytes and leave OUTPUT in |out_result|
+//            without touching any INPUT/OUTPUT file (files mentioned by
+//            other flags are still read and written).
+//
+// |out_result| and |undo_command| may be nullptr. In memory mode |out_result|
+// receives the OUTPUT bytes - empty for the read-only modes such as --info -
+// and |undo_command| the single-line command that inverts this run, when
+// there is one.
+int RunCommandLine(int argc, const char** argv,
+                   const std::vector<uint8_t>* input_bytes,
+                   std::vector<uint8_t>* out_result,
+                   std::string* undo_command);
+
+}  // namespace jxltran
+
+#endif  // TOOLS_JXLTRAN_API_H_
